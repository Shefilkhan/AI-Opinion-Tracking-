# Frontend Environment Variables
# Copy this file to .env.local and set values as needed.

# Base URL of the OpinionPulse backend API.
# Leave EMPTY for local development to use the Vite dev-server proxy
# (vite.config.ts proxies /api and /uploads to http://127.0.0.1:8000).
# Set an absolute URL (e.g. https://api.yourdomain.com) for production builds.
VITE_API_BASE_URL=
