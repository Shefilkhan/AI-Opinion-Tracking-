# Local secrets — copy to .env.local (gitignored). FastAPI loads .env and .env.local.

# Email Configuration (Gmail SMTP)
EMAIL_USER="youremail@gmail.com"
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Google OAuth (Continue with Google)
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Share the same client ID/secret with teammates via a secure channel (NOT git).
# Authorized redirect URIs in Google Console (add both for local dev):
#   http://127.0.0.1:8000/api/auth/google/callback
#   http://localhost:8000/api/auth/google/callback
# If the OAuth app is in "Testing" mode, add each teammate's Gmail under OAuth consent screen → Test users.
# Set OAuth consent screen App name to "OpinionPulse" for "Sign in to OpinionPulse" (see docs/AUTH_SETUP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_PROMPT=select_account

# Stripe (https://dashboard.stripe.com/test/apikeys)
# Create Products + recurring Prices in Stripe, then paste Price IDs (price_...) below.
# Amounts must match the OpinionPulse pricing page:
#
#   Starter    — $9/mo  OR  $84/yr   (shown as $7/mo when billed yearly)
#   Pro        — $29/mo OR  $276/yr  (shown as $23/mo when billed yearly)
#   Enterprise — $99/mo OR  $948/yr (shown as $79/mo when billed yearly; optional — app uses contact sales)
#
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Local webhook forwarding: stripe listen --forward-to localhost:8000/api/billing/webhook
STRIPE_PRICE_STARTER_MONTHLY=          # $9.00 / month
STRIPE_PRICE_STARTER_ANNUAL=           # $84.00 / year
STRIPE_PRICE_PRO_MONTHLY=              # $29.00 / month
STRIPE_PRICE_PRO_ANNUAL=               # $276.00 / year
STRIPE_PRICE_ENTERPRISE_MONTHLY=       # $99.00 / month (optional)
STRIPE_PRICE_ENTERPRISE_ANNUAL=        # $948.00 / year (optional)