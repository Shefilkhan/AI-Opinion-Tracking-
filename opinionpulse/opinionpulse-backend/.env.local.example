# Local secrets — copy to .env.local (gitignored). FastAPI loads .env and .env.local.

# Email Configuration (Gmail SMTP)
EMAIL_USER="youremail@gmail.com"
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Google OAuth (Continue with Google)
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Share the same client ID/secret with teammates via a secure channel (NOT git).
# Authorized redirect URIs in Google Console (add both for local dev):
#   http://127.0.0.1:8000/api/auth/google/callback
#   http://localhost:8000/api/auth/google/callback
# If the OAuth app is in "Testing" mode, add each teammate's Gmail under OAuth consent screen → Test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
